API_BASE_URL=https://eduteach-textbook-api.onrender.com

# Local Docker Qdrant needs no API key. Qdrant Cloud needs both set to your
# cluster's values (QDRANT_URL looks like https://xxxx.cloud.qdrant.io:6333).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Optional ingestion filters (scripts/ingest_book.py). Leave unset to ingest
# every published book in the catalog.
BOARD_FILTER=
GRADE_FILTER=
SUBJECT_FILTER=
LANGUAGE_FILTER=
